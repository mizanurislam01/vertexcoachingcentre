    <!-- Interactive JavaScript -->
    <script>
        const modal = document.getElementById('join-modal');
        const modalCourse = document.getElementById('modal-course');
        const modalSubject = document.getElementById('modal-subject');
        const mobileMenu = document.getElementById('mobile-menu');
        const toastBox = document.getElementById('toast-box');
        const toastTitle = document.getElementById('toast-title');
        const toastMessage = document.getElementById('toast-message');
        let toastTimer;

        function toggleMobileMenu() {
            mobileMenu.classList.toggle('hidden');
        }

        function openModal(selectedClass = '', selectedSubject = '') {
            if (selectedClass && modalCourse) {
                modalCourse.value = selectedClass;
            }
            if (selectedSubject && modalSubject) {
                modalSubject.value = selectedSubject;
            }
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Close modal when clicking outside the dialog card
        modal.addEventListener('click', function (e) {
            if (e.target === modal) {
                closeModal();
            }
        });

        function showToast(title, message) {
            toastTitle.textContent = title;
            toastMessage.textContent = message;
            toastBox.classList.remove('hidden');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toastBox.classList.add('hidden');
            }, 5000);
        }

        function handleFormSubmit(e) {
            // e.preventDefault();
            const form = e.target;
            const studentName = form.querySelector('[name="name"]')?.value || 'Student';
            const selectedClass = form.querySelector('[name="course"]')?.value || 'Class V–X';
            const selectedSubject = form.querySelector('[name="subject"]')?.value || 'Subject';

            closeModal();
            showToast(
                'Admission Request Submitted!',
                `Thank you, ${studentName}! Your enquiry for ${selectedClass} at Vertex Coaching Centre (Kamandanga) has been received. We will contact you shortly.`
            );
            form.reset();
        }

        function handleCallbackSubmit(e) {
            e.preventDefault();
            showToast(
                'Callback Requested!',
                'Thank you! Our team at Kamandanga Market will call you back shortly, or you can reach us at 6901081411.'
            );
            e.target.reset();
        }
    </script>
</body>
